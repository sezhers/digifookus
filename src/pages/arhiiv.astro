---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import BrowseTabs from "@/components/BrowseTabs.astro";
import PostFeed from "@/components/PostFeed.astro";
import Section from "@/components/Section.astro";
import BrowseValueList from "@/components/BrowseValueList.astro";
import { getAllPosts, getAllNotes, getAllEntries } from "@/utils/content";
import { getMetaValues } from "@/utils/browse";
import { getAssetPath } from "@/utils/url";

const allEntries = await getAllEntries();
const allPosts = await getAllPosts();
const allNotes = await getAllNotes();
const categories = getMetaValues(allEntries, "category");
---

<BaseLayout title="Arhiiv">
  <div class="layout-content">
    <PageHeader
      eyebrow="Arhiiv"
      title="Kõik kirjutised"
      lede="Artiklid ja märkmed pöördkronoloogilises järjekorras."
    />

    {categories.length > 0 && (
      <Section title="Kategooriad">
        <BrowseValueList
          items={categories.map(({ value, slug }) => ({
            label: value,
            href: getAssetPath(slug),
          }))}
        />
      </Section>
    )}

    <BrowseTabs defaultTab="essays">
      <Fragment slot="all">
        <PostFeed posts={allEntries} variant="archive" />
      </Fragment>
      <Fragment slot="essays">
        <PostFeed posts={allPosts} variant="archive" />
      </Fragment>
      <Fragment slot="notes">
        <PostFeed posts={allNotes} variant="archive" />
      </Fragment>
    </BrowseTabs>
  </div>
</BaseLayout>
