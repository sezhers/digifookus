---
import ArticleDetail from "@/components/ArticleDetail.astro";
import NoteDetail from "@/components/NoteDetail.astro";
import { getAllPosts, getAllNotes, getPostSlugPath, getNoteSlugPath } from "@/utils/content";
import { slugify } from "@/utils/text";

export async function getStaticPaths() {
  const [posts, notes] = await Promise.all([getAllPosts(), getAllNotes()]);

  const postPaths = posts
    .filter((post) => post.data.category)
    .map((post) => ({
      params: {
        category: slugify(post.data.category!),
        slug: getPostSlugPath(post.id, post.filePath),
      },
      props: { kind: "post" as const, post },
    }));

  const notePaths = notes
    .filter((note) => note.data.category)
    .map((note) => ({
      params: {
        category: slugify(note.data.category!),
        slug: getNoteSlugPath(note.id, note.filePath),
      },
      props: { kind: "note" as const, note },
    }));

  return [...postPaths, ...notePaths];
}

const { kind, post, note } = Astro.props;
---

{kind === "post" ? <ArticleDetail post={post} /> : <NoteDetail note={note} />}
