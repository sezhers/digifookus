---
import ArticleDetail from "@/components/ArticleDetail.astro";
import { getAllPosts, getPostSlugPath } from "@/utils/content";
import { slugify } from "@/utils/text";

export async function getStaticPaths() {
  const posts = await getAllPosts();

  return posts
    .filter((post) => post.data.category)
    .map((post) => ({
      params: {
        category: slugify(post.data.category!),
        slug: getPostSlugPath(post.id, post.filePath),
      },
      props: { post },
    }));
}

const { post } = Astro.props;
---

<ArticleDetail post={post} />
