---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import BrowseValueList from "@/components/BrowseValueList.astro";
import { getAllEntries } from "@/utils/content";
import { getYears } from "@/utils/browse";
import { getAssetPath } from "@/utils/url";

const allEntries = await getAllEntries();
const years = getYears(allEntries);
---

<BaseLayout title="Aastad">
  <div class="layout-content">
    <a
      href={getAssetPath("browse")}
      class="font-mono text-xs uppercase tracking-wide text-clay hover:underline"
    >
      ← Sirvi
    </a>

    <PageHeader eyebrow=" Sirvi" title="Aastad" />

    <div class="mt-8">
      <BrowseValueList
        items={years.map((year) => ({
          label: year,
          href: getAssetPath(`browse/years/${year}`),
        }))}
      />
    </div>
  </div>
</BaseLayout>
