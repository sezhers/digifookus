---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import StructuredData from "@/components/StructuredData.astro";
import { getAllPages, getPageSlugPath, getPageUrl } from "@/utils/content";
import { absoluteUrl, getAssetPath } from "@/utils/url";
import { getConfig } from "@/utils/config";
import { buildBreadcrumbSchema } from "@/utils/schema";

export async function getStaticPaths() {
  const pages = await getAllPages();

  return pages.map((page) => ({
    params: { slug: getPageSlugPath(page.id, page.filePath) },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);

const siteConfig = await getConfig();
const pageUrl = getPageUrl(page.id, page.filePath);
const personSchema = page.data.isPerson
  ? {
      "@context": "https://schema.org",
      "@type": "Person",
      name: page.data.title,
      url: absoluteUrl(pageUrl, Astro.site),
      ...(siteConfig.author.bio && { description: siteConfig.author.bio }),
      ...(page.data.sameAs?.length && { sameAs: page.data.sameAs }),
    }
  : undefined;

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: siteConfig.title, url: absoluteUrl("/", Astro.site) },
  ...(page.data.isPerson
    ? [{ name: "Meist", url: absoluteUrl(getAssetPath("meist"), Astro.site) }]
    : []),
  { name: page.data.title, url: absoluteUrl(pageUrl, Astro.site) },
]);

const schemas = [...(personSchema ? [personSchema] : []), breadcrumbSchema];
---

<BaseLayout title={page.data.title}>
  <StructuredData schema={schemas} slot="head" />
  <div class="layout-content">
    <PageHeader title={page.data.title} />

    <article data-pagefind-body class="markdown-content py-8">
      <meta data-pagefind-meta="title[content]" content={page.data.title} />
      <meta data-pagefind-sort="date[content]" content={page.data.updated?.toISOString()} />
      <Content />
    </article>
  </div>
</BaseLayout>
