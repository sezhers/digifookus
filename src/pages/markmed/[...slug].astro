---
/**
 * Fallback route for notes without a category — categorized notes live at
 * /<category>/<slug> instead (see src/pages/[category]/[slug].astro).
 */
import NoteDetail from "@/components/NoteDetail.astro";
import { getAllNotes, getNoteSlugPath } from "@/utils/content";

export async function getStaticPaths() {
  const notes = await getAllNotes();

  return notes
    .filter((note) => !note.data.category)
    .map((note) => ({
      params: { slug: getNoteSlugPath(note.id, note.filePath) },
      props: { note },
    }));
}

const { note } = Astro.props;
---

<NoteDetail note={note} />
