---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import BrowseTabs from "@/components/BrowseTabs.astro";
import PostFeed from "@/components/PostFeed.astro";
import { getAllPosts, getAllNotes, getAllEntries } from "@/utils/content";

const allEntries = await getAllEntries();
const allPosts = await getAllPosts();
const allNotes = await getAllNotes();
---

<BaseLayout title="Arhiiv">
  <div class="layout-content">
    <PageHeader
      eyebrow="Arhiiv"
      title="Kõik kirjutised"
      lede="Artiklid ja märkmed pöördkronoloogilises järjekorras."
    />

    <BrowseTabs defaultTab="essays">
      <Fragment slot="all">
        <PostFeed posts={allEntries} variant="archive" />
      </Fragment>
      <Fragment slot="essays">
        <PostFeed posts={allPosts} variant="archive" />
      </Fragment>
      <Fragment slot="notes">
        <PostFeed posts={allNotes} variant="archive" />
      </Fragment>
    </BrowseTabs>
  </div>
</BaseLayout>
