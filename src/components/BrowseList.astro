---
import type { CollectionEntry } from "astro:content";
import PostFeed from "@/components/PostFeed.astro";

interface Props {
  entries: (CollectionEntry<"posts"> | CollectionEntry<"notes">)[];
  emptyMessage?: string;
}

const { entries, emptyMessage = "Siin pole veel midagi." } = Astro.props;
---

{entries.length > 0 ? (
  <PostFeed posts={entries} variant="archive" />
) : (
  <p class="py-8 text-sm italic text-muted-foreground">{emptyMessage}</p>
)}
