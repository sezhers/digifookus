---
import { getConfig } from "@/utils/config";
import { getAssetPath } from "@/utils/url";

const siteConfig = await getConfig();
---
<header class="flex sticky top-0 z-40 backdrop-blur-xs border-b border-border">
  <div class="layout-page h-16 flex items-center justify-between gap-4">
    <a href="/" class="font-normal text-base italic shrink-0">
      {siteConfig.title}
    </a>
    <div class="flex items-center gap-6">
      <nav class="flex gap-4 font-mono text-muted-foreground text-xs tracking-wide">
        {siteConfig.navigation?.map((item) => (
          <a href={item.url}>{item.title}</a>
        ))}
      </nav>
      <div class="hidden sm:flex">
        <pagefind-modal-trigger placeholder="Otsi"></pagefind-modal-trigger>
      </div>
      <div class="flex sm:hidden">
        <pagefind-modal-trigger compact hide-shortcut></pagefind-modal-trigger>
      </div>
    </div>
  </div>
  <pagefind-config bundle-path={getAssetPath("pagefind/")}></pagefind-config>
  <pagefind-modal></pagefind-modal>
  <script is:inline>
    customElements.whenDefined("pagefind-modal").then(() => {
      const translations = {
        placeholder: "Otsi",
        clear_search: "Tühjenda",
        load_more: "Laadi rohkem tulemusi",
        search_label: "Otsi sellelt saidilt",
        filters_label: "Filtrid",
        zero_results: "Tulemusi ei leitud otsingule [SEARCH_TERM]",
        many_results: "[COUNT] tulemust otsingule [SEARCH_TERM]",
        one_result: "[COUNT] tulemus otsingule [SEARCH_TERM]",
        total_zero_results: "Tulemusi ei leitud",
        total_one_result: "[COUNT] tulemus",
        total_many_results: "[COUNT] tulemust",
        alt_search: "Tulemusi ei leitud otsingule [SEARCH_TERM]. Kuvatakse tulemused otsingule [DIFFERENT_TERM]",
        search_suggestion: "Tulemusi ei leitud otsingule [SEARCH_TERM]. Proovi mõnda järgnevat otsingut:",
        searching: "Otsin: [SEARCH_TERM]...",
        results_label: "Otsingutulemused",
        keyboard_navigate: "liikumine",
        keyboard_select: "valimine",
        keyboard_clear: "tühjendamine",
        keyboard_close: "sulgemine",
        keyboard_search: "otsimine",
        error_search: "Otsing ebaõnnestus",
        filter_selected_one: "[COUNT] valitud",
        filter_selected_many: "[COUNT] valitud",
        input_hint: "Tulemused ilmuvad kirjutamise ajal",
        loading: "Laadimine",
      };

      const modal = document.querySelector("pagefind-modal");
      const apply = () => modal.instance?.setTranslations(translations);

      if (modal.instance) {
        apply();
      } else {
        const iv = setInterval(() => {
          if (modal.instance) {
            apply();
            clearInterval(iv);
          }
        }, 50);
      }
    });
  </script>
</header>
